# App
VITE_APP_URL=https://your-domain.vercel.app

# Vercel Analytics (from Vercel dashboard → project → Analytics)
VITE_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Posthog (optional product analytics)
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry (optional error tracking)
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Feature flags (e.g. LaunchDarkly)
VITE_LAUNCHDARKLY_CLIENT_ID=your-launchdarkly-client-id
